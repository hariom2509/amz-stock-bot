{
  "manifest_version": 3,
  "name": "Amazon Stock Watcher",
  "version": "1.0.0",
  "description": "Instant Telegram alerts when out-of-stock Amazon products become available.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*.YOURDOMAIN.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Amazon Stock Watcher",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
