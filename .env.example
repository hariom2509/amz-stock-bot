# ─────────────────────────────────────────────────────────────────────────────
# Amazon Stock Watcher — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Your Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHI...

# Your Telegram Bot username (without @)
BOT_USERNAME=AmazonStockWatcherBot

# ── OPTIONAL: SECURITY ───────────────────────────────────────────────────────

# Comma-separated list of Telegram chat IDs allowed to use the bot.
# Leave empty to allow anyone who can message the bot.
ALLOWED_TELEGRAM_CHAT_IDS=

# ── DATABASE ─────────────────────────────────────────────────────────────────

# Path to SQLite database file (will be created automatically)
DATABASE_PATH=data/watcher.db

# ── MONITORING INTERVALS ─────────────────────────────────────────────────────

# Fast baseline check interval in seconds (default: 3)
FAST_CHECK_INTERVAL_SECONDS=3

# Normal check interval in seconds (default: 15)
NORMAL_CHECK_INTERVAL_SECONDS=15

# Turbo check interval in seconds (default: 3)
TURBO_CHECK_INTERVAL_SECONDS=3

# Maximum concurrent checks
MAX_CONCURRENT_CHECKS=5

# Maximum watches per user
MAX_WATCHES_PER_USER=5

# ── LOGGING ──────────────────────────────────────────────────────────────────

LOG_LEVEL=INFO
LOG_FILE=logs/watcher.log
